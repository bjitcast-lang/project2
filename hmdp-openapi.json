{
  "openapi": "3.0.3",
  "info": {
    "title": "黑马点评 Hmdp API",
    "version": "1.0.0",
    "description": "黑马点评项目接口文档（基于当前项目代码生成）。\n\n【认证方式】登录成功后 `POST /user/login` 返回的 `data` 即 token，后续请求把它放进请求头 `authorization` 即可。前端已自动从 sessionStorage 读取并附加。\n\n【未登录】受保护接口在缺少/无效 token 时返回 HTTP 401，前端会自动跳转登录页。\n\n【验证码】教学项目不真实发短信，验证码由后端 `sendCode` 打印在控制台日志中。\n\n【响应格式】统一为 `{success, errorMsg, data, total}`，`success=false` 时 `data` 为 null。"
  },
  "servers": [
    {
      "url": "http://localhost:8081",
      "description": "直连 Spring Boot 后端（推荐 Apifox 使用）"
    },
    {
      "url": "http://localhost:8080/api",
      "description": "经 nginx 代理（与前端同源；nginx 会剥离 /api 前缀）"
    }
  ],
  "tags": [
    { "name": "用户登录", "description": "验证码登录、登出、当前用户" },
    { "name": "商铺", "description": "商铺详情、增改、按类型/名称查询" },
    { "name": "商铺类型", "description": "商铺分类列表" },
    { "name": "探店笔记", "description": "发布、点赞、热门、我的笔记" },
    { "name": "优惠券", "description": "普通券、秒杀券、店铺券列表" },
    { "name": "秒杀", "description": "秒杀下单" },
    { "name": "文件上传", "description": "探店图片上传与删除" }
  ],
  "security": [{ "tokenAuth": [] }],
  "paths": {
    "/user/code": {
      "post": {
        "tags": ["用户登录"],
        "summary": "发送手机验证码",
        "description": "校验手机号格式后生成 6 位验证码，存入 Redis（key: `login:code:{phone}`，有效期 2 分钟），并打印到后端控制台。\n\n**Apifox 测试提示**：调用后去后端控制台找 `成功发送验证码：xxxxxx`。",
        "security": [],
        "parameters": [
          {
            "name": "phone",
            "in": "query",
            "required": true,
            "description": "手机号（11 位，1 开头）",
            "schema": { "type": "string", "example": "13838411438" }
          }
        ],
        "responses": {
          "200": {
            "description": "发送成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result" }
              }
            }
          }
        }
      }
    },
    "/user/login": {
      "post": {
        "tags": ["用户登录"],
        "summary": "验证码登录",
        "description": "校验 Redis 中的验证码，成功则生成 UUID token，用户信息以 Hash 存入 Redis（`login:token:{token}`），验证码随即删除。\n\n**返回的 `data` 就是 token 字符串**，请保存到环境变量（如 `{{token}}`）供后续接口使用。\n\n手机号不存在时会自动注册新用户。",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginFormDTO" },
              "example": { "phone": "13838411438", "code": "123456" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功，data 为 token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResultToken" },
                "example": {
                  "success": true,
                  "data": "a1b2c3d4e5f6478899aabbccddeeff00"
                }
              }
            }
          }
        }
      }
    },
    "/user/logout": {
      "post": {
        "tags": ["用户登录"],
        "summary": "退出登录",
        "description": "从请求头 `authorization` 取出 token，删除 Redis 中的 `login:token:{token}`。",
        "responses": {
          "200": {
            "description": "退出成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/user/me": {
      "get": {
        "tags": ["用户登录"],
        "summary": "获取当前登录用户",
        "description": "从 ThreadLocal 取出当前用户（由 RefreshTokenInterceptor 放入）。",
        "responses": {
          "200": {
            "description": "当前用户信息",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResultUserDTO" },
                "example": {
                  "success": true,
                  "data": { "id": 2, "nickName": "可可今天不吃肉", "icon": "/imgs/icons/kkjtbcr.jpg" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/user/info/{id}": {
      "get": {
        "tags": ["用户登录"],
        "summary": "查询用户详情",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "用户 id",
            "schema": { "type": "integer", "format": "int64", "example": 2 }
          }
        ],
        "responses": {
          "200": {
            "description": "用户详情；无详情记录时 data 为 null",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResultUserInfo" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/shop/{id}": {
      "get": {
        "tags": ["商铺"],
        "summary": "根据 id 查询商铺详情",
        "description": "先查 Redis 缓存 `cache:shop:{id}`，命中则直接返回；未命中再查数据库并写回缓存（30 分钟）。店铺不存在时返回 `success=false, errorMsg=\"店铺不存在\"`。",
        "security": [],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "商铺 id",
            "schema": { "type": "integer", "format": "int64", "example": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "商铺详情",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResultShop" }
              }
            }
          }
        }
      }
    },
    "/shop": {
      "post": {
        "tags": ["商铺"],
        "summary": "新增商铺",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Shop" },
              "example": {
                "name": "茶百道",
                "typeId": 1,
                "images": "/imgs/types/cb.png",
                "area": "陆家嘴",
                "address": "陆家嘴环路 1000 号",
                "x": 121.499809,
                "y": 31.239666,
                "avgPrice": 25,
                "sold": 0,
                "comments": 0,
                "score": 45,
                "openHours": "10:00-22:00"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "新增成功，data 为商铺 id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResultLong" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["商铺"],
        "summary": "更新商铺",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Shop" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功时 `data` 为空；店铺 id 为空时返回 `success=false, errorMsg=\"店铺id不能为空\"`。更新后会删除 Redis 缓存 `cache:shop:{id}`。",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result" }
              }
            }
          }
        }
      }
    },
    "/shop/of/type": {
      "get": {
        "tags": ["商铺"],
        "summary": "根据商铺类型分页查询",
        "security": [],
        "parameters": [
          {
            "name": "typeId",
            "in": "query",
            "required": true,
            "description": "商铺类型 id",
            "schema": { "type": "integer", "example": 1 }
          },
          {
            "name": "current",
            "in": "query",
            "required": false,
            "description": "页码，默认 1（每页 5 条）",
            "schema": { "type": "integer", "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "商铺列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResultShopList" }
              }
            }
          }
        }
      }
    },
    "/shop/of/name": {
      "get": {
        "tags": ["商铺"],
        "summary": "根据名称关键字分页查询",
        "security": [],
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": false,
            "description": "商铺名称关键字，为空则查全部",
            "schema": { "type": "string", "example": "茶" }
          },
          {
            "name": "current",
            "in": "query",
            "required": false,
            "description": "页码，默认 1（每页 10 条）",
            "schema": { "type": "integer", "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "商铺列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResultShopList" }
              }
            }
          }
        }
      }
    },
    "/shop-type/list": {
      "get": {
        "tags": ["商铺类型"],
        "summary": "查询所有商铺类型",
        "description": "按 sort 升序返回全部类型。",
        "security": [],
        "responses": {
          "200": {
            "description": "类型列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResultShopTypeList" }
              }
            }
          }
        }
      }
    },
    "/blog": {
      "post": {
        "tags": ["探店笔记"],
        "summary": "发布探店笔记",
        "description": "userId 由后端从当前登录用户取，无需传入。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Blog" },
              "example": {
                "shopId": 1,
                "title": "探店日记",
                "images": "/imgs/blogs/blog1.jpg,/imgs/blogs/blog2.jpg",
                "content": "环境很好，味道不错"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "发布成功，data 为笔记 id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResultLong" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/blog/like/{id}": {
      "put": {
        "tags": ["探店笔记"],
        "summary": "点赞探店笔记",
        "description": "当前实现为 `liked = liked + 1`（尚未做一人一赞去重）。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "笔记 id",
            "schema": { "type": "integer", "format": "int64", "example": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "点赞成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/blog/of/me": {
      "get": {
        "tags": ["探店笔记"],
        "summary": "查询当前用户的探店笔记",
        "parameters": [
          {
            "name": "current",
            "in": "query",
            "required": false,
            "description": "页码，默认 1（每页 10 条）",
            "schema": { "type": "integer", "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "笔记列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResultBlogList" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/blog/hot": {
      "get": {
        "tags": ["探店笔记"],
        "summary": "查询热门探店笔记",
        "description": "按点赞数倒序分页，并填充作者昵称与头像。",
        "security": [],
        "parameters": [
          {
            "name": "current",
            "in": "query",
            "required": false,
            "description": "页码，默认 1（每页 10 条）",
            "schema": { "type": "integer", "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "笔记列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResultBlogList" }
              }
            }
          }
        }
      }
    },
    "/voucher": {
      "post": {
        "tags": ["优惠券"],
        "summary": "新增普通优惠券",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Voucher" },
              "example": {
                "shopId": 1,
                "title": "代金券",
                "subTitle": "周一至周五可用",
                "rules": "全场通用",
                "payValue": 80,
                "actualValue": 100,
                "type": 0,
                "status": 1
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "新增成功，data 为优惠券 id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResultLong" }
              }
            }
          }
        }
      }
    },
    "/voucher/seckill": {
      "post": {
        "tags": ["优惠券"],
        "summary": "新增秒杀优惠券",
        "description": "同时写入 tb_voucher 与 tb_seckill_voucher。`type` 固定为 1；`stock`、`beginTime`、`endTime` 为秒杀扩展字段。",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SeckillVoucherRequest" },
              "example": {
                "shopId": 1,
                "title": "100元代金券",
                "subTitle": "周一至周五可用",
                "rules": "全场通用",
                "payValue": 80,
                "actualValue": 100,
                "type": 1,
                "status": 1,
                "stock": 100,
                "beginTime": "2026-10-01T10:00:00",
                "endTime": "2026-12-31T23:59:59"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "新增成功，data 为优惠券 id",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResultLong" }
              }
            }
          }
        }
      }
    },
    "/voucher/list/{shopId}": {
      "get": {
        "tags": ["优惠券"],
        "summary": "查询店铺的优惠券列表",
        "security": [],
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "description": "商铺 id",
            "schema": { "type": "integer", "format": "int64", "example": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "优惠券列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResultVoucherList" }
              }
            }
          }
        }
      }
    },
    "/voucher-order/seckill/{id}": {
      "post": {
        "tags": ["秒杀"],
        "summary": "秒杀下单",
        "description": "⚠️ 当前项目该方法仍是 TODO 桩实现，固定返回 `success=false, errorMsg=\"功能未完成\"`。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "优惠券 id",
            "schema": { "type": "integer", "format": "int64", "example": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "当前固定返回功能未完成",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result" },
                "example": {
                  "success": false,
                  "errorMsg": "功能未完成"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/upload/blog": {
      "post": {
        "tags": ["文件上传"],
        "summary": "上传探店图片",
        "description": "保存到 `SystemConstants.IMAGE_UPLOAD_DIR` 下按哈希分目录存放，返回相对文件名供笔记引用。",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "图片文件"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "上传成功，data 为文件相对路径",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResultString" },
                "example": {
                  "success": true,
                  "data": "/blogs/3/5/1a2b3c4d.jpg"
                }
              }
            }
          }
        }
      }
    },
    "/upload/blog/delete": {
      "get": {
        "tags": ["文件上传"],
        "summary": "删除探店图片",
        "security": [],
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "description": "文件名（上传接口返回的相对路径）",
            "schema": { "type": "string", "example": "/blogs/3/5/1a2b3c4d.jpg" }
          }
        ],
        "responses": {
          "200": {
            "description": "删除成功；名称为目录时返回错误",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "tokenAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "authorization",
        "description": "登录接口返回的 token 字符串，直接放入请求头，无需 Bearer 前缀。"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "未登录或 token 无效/过期。拦截器只执行 response.setStatus(401)，响应体为空（不是 JSON）。前端收到 401 会跳转登录页。"
      }
    },
    "schemas": {
      "Result": {
        "type": "object",
        "description": "统一响应体。项目开启了 `spring.jackson.default-property-inclusion: non_null`，值为 null 的字段不会出现在响应 JSON 中（例如成功时通常只有 `{\"success\":true}`）。",
        "properties": {
          "success": { "type": "boolean", "description": "是否成功" },
          "errorMsg": { "type": "string", "nullable": true, "description": "失败原因" },
          "data": { "nullable": true, "description": "业务数据，类型随接口而定" },
          "total": { "type": "integer", "format": "int64", "nullable": true, "description": "总条数（分页接口使用，当前实现多为 null）" }
        },
        "required": ["success"]
      },
      "ResultToken": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "errorMsg": { "type": "string", "nullable": true },
          "data": { "type": "string", "description": "登录 token" },
          "total": { "type": "integer", "format": "int64", "nullable": true }
        }
      },
      "ResultLong": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "errorMsg": { "type": "string", "nullable": true },
          "data": { "type": "integer", "format": "int64" },
          "total": { "type": "integer", "format": "int64", "nullable": true }
        }
      },
      "ResultString": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "errorMsg": { "type": "string", "nullable": true },
          "data": { "type": "string" },
          "total": { "type": "integer", "format": "int64", "nullable": true }
        }
      },
      "ResultUserDTO": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "errorMsg": { "type": "string", "nullable": true },
          "data": { "$ref": "#/components/schemas/UserDTO" },
          "total": { "type": "integer", "format": "int64", "nullable": true }
        }
      },
      "ResultUserInfo": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "errorMsg": { "type": "string", "nullable": true },
          "data": { "$ref": "#/components/schemas/UserInfo" },
