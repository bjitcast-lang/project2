{
  "info": {
    "name": "本地生活交易平台 - 核心链路",
    "description": "秒杀 → 查询 → 支付 → 回调 → 对账 → 观测。可导入 Apifox。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base", "value": "http://127.0.0.1:8081" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "hmdp-admin-token" },
    { "key": "voucherId", "value": "1" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "管理端",
      "item": [
        {
          "name": "预热秒杀库存",
          "request": {
            "method": "POST",
            "header": [ { "key": "X-Admin-Token", "value": "{{adminToken}}" } ],
            "url": { "raw": "{{base}}/admin/seckill/preheat/{{voucherId}}?force=true", "query": [ { "key": "force", "value": "true" } ] }
          }
        },
        {
          "name": "签发压测 token",
          "request": {
            "method": "POST",
            "header": [ { "key": "X-Admin-Token", "value": "{{adminToken}}" } ],
            "url": { "raw": "{{base}}/admin/test/token?userId=1", "query": [ { "key": "userId", "value": "1" } ] }
          }
        },
        {
          "name": "秒杀观测",
          "request": {
            "method": "GET",
            "header": [ { "key": "X-Admin-Token", "value": "{{adminToken}}" } ],
            "url": { "raw": "{{base}}/admin/seckill/stats?voucherId={{voucherId}}", "query": [ { "key": "voucherId", "value": "{{voucherId}}" } ] }
          }
        },
        {
          "name": "手动对账",
          "request": {
            "method": "POST",
            "header": [ { "key": "X-Admin-Token", "value": "{{adminToken}}" } ],
            "url": { "raw": "{{base}}/admin/reconcile/run?date=2026-11-18", "query": [ { "key": "date", "value": "2026-11-18" } ] }
          }
        },
        {
          "name": "对账差异",
          "request": {
            "method": "GET",
            "header": [ { "key": "X-Admin-Token", "value": "{{adminToken}}" } ],
            "url": { "raw": "{{base}}/admin/reconcile/diff?date=2026-11-18", "query": [ { "key": "date", "value": "2026-11-18" } ] }
          }
        }
      ]
    },
    {
      "name": "订单",
      "item": [
        {
          "name": "秒杀下单",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success && body.data) pm.collectionVariables.set('orderId', String(body.data));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "authorization", "value": "{{token}}" } ],
            "url": { "raw": "{{base}}/voucher-order/seckill/{{voucherId}}" }
          }
        },
        {
          "name": "订单详情",
          "request": {
            "method": "GET",
            "header": [ { "key": "authorization", "value": "{{token}}" } ],
            "url": { "raw": "{{base}}/voucher-order/{{orderId}}" }
          }
        },
        {
          "name": "我的订单",
          "request": {
            "method": "GET",
            "header": [ { "key": "authorization", "value": "{{token}}" } ],
            "url": { "raw": "{{base}}/voucher-order/list?current=1", "query": [ { "key": "current", "value": "1" } ] }
          }
        },
        {
          "name": "发起支付",
          "request": {
            "method": "POST",
            "header": [ { "key": "authorization", "value": "{{token}}" } ],
            "url": { "raw": "{{base}}/voucher-order/{{orderId}}/pay" }
          }
        },
        {
          "name": "支付回调",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{orderId}},\n  \"tradeNo\": \"PAY{{orderId}}\",\n  \"amount\": 1000,\n  \"channel\": 1,\n  \"success\": true,\n  \"timestamp\": 0,\n  \"sign\": \"\"\n}"
            },
            "url": { "raw": "{{base}}/voucher-order/pay/notify" }
          }
        }
      ]
    }
  ]
}
